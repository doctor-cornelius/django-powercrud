FROM python:3.14-slim-bookworm AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG PROJECT_DIR=django_powercrud
ARG USER=devuser
ARG USERHOME=/home/${USER}
# renovate: datasource=npm depName=npm versioning=semver
ARG NPM_VERSION=11.17.0
# renovate: datasource=pypi depName=wheel versioning=pep440
ARG WHEEL_VERSION=0.47.0
ARG PLAYWRIGHT_VERSION=1.58.0
ARG PROMPT_CODE='\n\[\e[0m\]🐳 \[\e[0m\][\[\e[0;38;5;226m\]$(git branch 2>/dev/null | grep '"'"'^*'"'"' | colrm 1 2)\[\e[0m\]] \[\e[0;91m\]\u\[\e[0m\]: \[\e[0;96m\]\w\n\[\e[0m\]\$\[\e[0m\] '

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100

# Install git, node.js, nano and clean up
RUN apt-get update -y && \
    apt-get install --no-install-recommends -y curl git git-lfs openssh-client bsdmainutils nano && \
    apt-get install -y ca-certificates gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    npm install -g npm@${NPM_VERSION} && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# User setup (FROM YOUR WORKING VERSION)
RUN useradd -m -s /bin/bash --create-home ${USER} && \
    cd ${USERHOME} && mkdir .local && mkdir .local/bin && mkdir .local/scripts && mkdir ${USERHOME}/${PROJECT_DIR} && \
    chown -R ${USER}: ${USERHOME} && chown -R ${USER}: ${USERHOME}/${PROJECT_DIR} && \
    echo "export PATH=\"${USERHOME}/.local/bin:${USERHOME}/.local/scripts:\$PATH\"" >> ${USERHOME}/.bashrc && \
    echo "PS1='${PROMPT_CODE}'" >> /home/${USER}/.bashrc && \
    echo "cd ~/${PROJECT_DIR}" >> /home/${USER}/.bashrc && \
    echo "PROJECT_DIR=${PROJECT_DIR}" >> /root/.bashrc && \
    echo "PS1='${PROMPT_CODE}'" >> /root/.bashrc


WORKDIR ${USERHOME}/${PROJECT_DIR}

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    install -Dm755 /root/.local/bin/uv /usr/local/bin/uv && \
    install -Dm755 /root/.local/bin/uvx /usr/local/bin/uvx
ENV UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/usr/local/ms-playwright

# Install the pinned Playwright client and Chromium before general Python
# dependencies so routine lockfile updates do not invalidate this costly layer.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system "wheel==${WHEEL_VERSION}" "playwright==${PLAYWRIGHT_VERSION}" && \
    python -m playwright install --with-deps chromium

# Install locked Python dependencies separately from the project source so this
# expensive layer changes only when Python dependency metadata changes.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-extras --no-install-project && \
    test "$(python -c 'from importlib.metadata import version; print(version("playwright"))')" = "${PLAYWRIGHT_VERSION}"

# Install node packages after Playwright so package-lock updates do not trigger
# another browser download. Lightning CSS requires its optional Linux artifact.
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --include=optional && chown -R ${USER}:${USER} node_modules

COPY --chown=${USER}:${USER} . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --all-extras

USER ${USER}

CMD ["/bin/bash"]
