# for running tests locally and reporting coverage only on powercrud
set -euo pipefail

function show_help {
    cat <<'EOF'
Usage: ./runtests [OPTION] [TEST_PATH ...]

Options:
  --help, -h        Show this help message and exit.
  --pytest          Run the default non-Playwright suite and focused Bootstrap server coverage.
  --playwright      Run the default Playwright suite and focused Bootstrap browser coverage.
  --rebuild-assets  Build static assets before running the selected tests.

Arguments:
  TEST_PATH         Run one or more pytest test paths/node ids in a single run.

Examples:
  ./runtests --playwright
  ./runtests --playwright src/tests/playwright/test_bulk_selection.py::test_bulk_selection_toggle
  ./runtests --rebuild-assets src/tests/playwright/test_bulk_selection.py::test_bulk_selection_toggle
EOF
}

MODE="all"
REBUILD_ASSETS="false"
declare -a TEST_PATHS=()

for arg in "$@"; do
    case "$arg" in
        --help|-h)
            show_help
            exit 0
            ;;
        --pytest)
            if [ "$MODE" != "all" ]; then
                show_help
                exit 1
            fi
            MODE="pytest"
            ;;
        --playwright)
            if [ "$MODE" != "all" ]; then
                show_help
                exit 1
            fi
            MODE="playwright"
            ;;
        --rebuild-assets)
            REBUILD_ASSETS="true"
            ;;
        --*)
            echo "Error: unknown option '$arg'."
            show_help
            exit 1
            ;;
        *)
            TEST_PATHS+=("$arg")
            ;;
    esac
done

function build_assets {
    echo "Building static assets..."
    npm run build
}

BOOTSTRAP_SERVER_TESTS=(
    src/tests/test_bootstrap_template_pack.py
    src/tests/test_template_pack_behaviour_matrix.py
    src/tests/test_form_filter_template_mixins.py::test_generated_datetime_form_and_filter_use_true_datetime_controls
    src/tests/test_form_mixin_extended.py::test_custom_model_form_uses_pack_policy_only_for_silent_default_widgets
    src/tests/test_inline_editing_mixin.py::test_generated_inline_m2m_requests_pack_multiselect_enhancement
    src/tests/test_bulk_view_mixin.py::test_bulk_field_info_uses_policy_owned_controls_for_selects
)

BOOTSTRAP_PLAYWRIGHT_TESTS=(
    src/tests/playwright/test_template_pack_behaviour_matrix.py::test_shared_favourite_application_uses_the_same_list_shell
    src/tests/playwright/test_bootstrap_modal_presentation.py
    src/tests/playwright/test_bootstrap_manual_static_assets.py
    src/tests/playwright/test_row_actions_column_layout.py
    src/tests/playwright/test_modal_crud.py::test_modal_multiselect_uses_pack_widget_and_clear_all
    src/tests/playwright/test_inline_editing.py::test_inline_m2m_uses_compact_pack_multiselect
)

function run_bootstrap_server_tests {
    echo "Running focused Bootstrap server coverage..."
    DJANGO_SETTINGS_MODULE=tests.settings_bootstrap \
        pytest -m "not playwright" --cov-append --no-cov-on-fail \
        "${BOOTSTRAP_SERVER_TESTS[@]}"
}

function run_bootstrap_playwright_tests {
    echo "Running focused Bootstrap browser coverage..."
    DJANGO_SETTINGS_MODULE=tests.settings_bootstrap \
        pytest -m playwright --cov-append --no-cov-on-fail \
        "${BOOTSTRAP_PLAYWRIGHT_TESTS[@]}"
}

if [ "${#TEST_PATHS[@]}" -gt 0 ]; then
    # An explicit settings module selects an intentional presentation-specific
    # test environment, including for focused Playwright coverage. Fall back
    # to the normal test settings only when the caller has not selected one.
    if [ -z "${DJANGO_SETTINGS_MODULE:-}" ] || [ "${DJANGO_SETTINGS_MODULE:-}" = "config.settings" ]; then
        use_minimal_settings="false"
        use_default_settings="false"
        for test_path in "${TEST_PATHS[@]}"; do
            if [[ "$test_path" == *"minimal"* ]]; then
                use_minimal_settings="true"
            else
                use_default_settings="true"
            fi
        done

        if [ "$use_minimal_settings" = "true" ] && [ "$use_default_settings" = "true" ]; then
            echo "Error: cannot mix minimal-settings tests with regular tests in one ./runtests call."
            echo "Set DJANGO_SETTINGS_MODULE explicitly if you really want to override this safeguard."
            exit 1
        fi

        if [ "$use_minimal_settings" = "true" ]; then
            export DJANGO_SETTINGS_MODULE=tests.settings_minimal
        else
            export DJANGO_SETTINGS_MODULE=tests.settings
        fi
    fi

    if [ "$MODE" = "playwright" ] || [ "$REBUILD_ASSETS" = "true" ]; then
        build_assets
    fi

    if [ "$MODE" = "pytest" ]; then
        pytest -m "not playwright" "${TEST_PATHS[@]}"
    elif [ "$MODE" = "playwright" ]; then
        pytest -m playwright --no-cov-on-fail "${TEST_PATHS[@]}"
    else
        pytest "${TEST_PATHS[@]}"
    fi
    exit $?
fi

# delete any existing coverage reports
coverage erase
rm -rf htmlcov
rm -f coverage.xml

# Default suites use the lightweight settings; focused pack coverage selects
# its explicit settings overlay for the duration of each pytest command.
export DJANGO_SETTINGS_MODULE=tests.settings

if [ "$MODE" = "pytest" ]; then
    if [ "$REBUILD_ASSETS" = "true" ]; then
        build_assets
    fi
    pytest -m "not playwright"
    run_bootstrap_server_tests
elif [ "$MODE" = "playwright" ]; then
    build_assets
    pytest -m playwright --no-cov-on-fail
    run_bootstrap_playwright_tests
else
    # Core + async suite with coverage (skips Playwright)
    pytest -m "not playwright"
    run_bootstrap_server_tests

    # Ensure the built bundle exists for manifest mode
    build_assets

    # Playwright UI checks
    pytest -m playwright --cov-append --no-cov-on-fail
    run_bootstrap_playwright_tests
fi

coverage html
